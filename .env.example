# ==========================================
# Equipoise Docker Compose Environment Variables
# ==========================================

# PostgreSQL Settings
POSTGRES_DB=equipoisedb
POSTGRES_USER=equipoise
POSTGRES_PASSWORD=equipoise_secret_password
POSTGRES_PORT=5432

# Backend Settings
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/equipoisedb
SPRING_DATASOURCE_USERNAME=equipoise
SPRING_DATASOURCE_PASSWORD=equipoise_secret_password
JWT_SECRET=EquipoiseProductionSecretKeyForJwtTokensThatIsLongEnough2026_SecureKey

# Frontend Settings
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080/api

# Notification Settings (Optional)
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=notifications@equipoise.local

# Integrations (Optional Jira Cloud & iCal Feed)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=statusCategory != Done ORDER BY created DESC
ICAL_FEED_URL=
APP_INTEGRATIONS_SYNC_CRON=0 */30 * * * *

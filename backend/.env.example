# ==========================================
# Equipoise Backend Environment Variables
# ==========================================

# Active Spring Profile (dev | prod)
# dev: Uses local file-based H2 database (./data/equipoise)
# prod: Uses PostgreSQL with persistent storage
SPRING_PROFILES_ACTIVE=dev

# Application Server Port
PORT=8080

# PostgreSQL Configuration (used when SPRING_PROFILES_ACTIVE=prod)
POSTGRES_DB=equipoisedb
POSTGRES_USER=equipoise
POSTGRES_PASSWORD=equipoise_secret_password
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/equipoisedb
SPRING_DATASOURCE_USERNAME=equipoise
SPRING_DATASOURCE_PASSWORD=equipoise_secret_password

# JWT Authentication Configuration
JWT_SECRET=EquipoiseDevOnlySecretKeyForJwtTokensThatIsLongEnough2026_ChangeInProd

# CORS Configuration (comma-separated allowed origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Notification Services (Slack & Email)
# Both channels are optional and only enabled when environment variables are set;
# otherwise messages are safely logged and no external requests are made.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_ME

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=your_smtp_password
MAIL_FROM=notifications@equipoise.local
APP_DIGEST_CRON=0 0 9 * * MON

# Integrations (Jira Cloud & iCal Calendar)
# Both adapters run with MockTaskSource & MockLeaveSource (Demo mode) unless
# the real API credentials or feed URLs are provided below.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=integrations@your-company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_JQL=statusCategory != Done ORDER BY created DESC

ICAL_FEED_URL=https://calendar.google.com/calendar/ical/your_feed/public/basic.ics
APP_INTEGRATIONS_SYNC_CRON=0 */30 * * * *
